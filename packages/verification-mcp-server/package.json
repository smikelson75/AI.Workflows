{
  "name": "@ai-workflows/verification-mcp-server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "verification-mcp-server": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-test-module-mocks --test-timeout=10000 --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-test-module-mocks --test-timeout=10000 --import tsx --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "test:mutation": "stryker run",
    "verify": "npm run typecheck && eslint . --max-warnings=0 && prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-n": "^17.15.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
