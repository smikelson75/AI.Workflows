#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$root" ]] || exit 0
validator="$root/.github/skills/deterministic-verification/scripts/validate-report.sh"
gate_eval="$root/.github/skills/deterministic-verification/scripts/evaluate-integration-gate.sh"
[[ -x "$validator" && -x "$gate_eval" ]] || { printf '%s\n' 'missing deterministic verification scripts' >&2; exit 1; }

if [[ -f out/engineer-a-report.json ]]; then
  "$validator" --kind a --report out/engineer-a-report.json >/dev/null
  gate="$("$gate_eval" --report out/engineer-a-report.json)"
  if [[ "$(jq -r '.integrationRequired' <<< "$gate")" == true ]]; then
    [[ -f out/engineer-b-report.json ]] || { printf '%s\n' 'integration gate requires out/engineer-b-report.json' >&2; exit 1; }
    "$validator" --kind b --report out/engineer-b-report.json >/dev/null
  fi
fi