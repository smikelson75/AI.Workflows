#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$root" ]] || exit 0
validator="$root/.github/skills/deterministic-verification/scripts/validate-report.sh"
[[ -x "$validator" ]] || { printf '%s\n' 'missing deterministic validation script' >&2; exit 1; }
role_scope="$root/.github/skills/deterministic-verification/scripts/check-role-scope.sh"
[[ -x "$role_scope" ]] || { printf '%s\n' 'missing deterministic role-scope script' >&2; exit 1; }

reports=(out/engineer-a-report.json out/engineer-b-report.json)
for report in "${reports[@]}"; do
  if [[ -f "$report" ]]; then
    kind=a
    [[ "$report" == *engineer-b* ]] && kind=b
    "$validator" --kind "$kind" --report "$report" >/dev/null
  fi
done

"$role_scope"